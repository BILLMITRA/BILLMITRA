BILLMITRA_DOMAIN=billing.example.com
# Generate a random secret of at least 32 characters before deployment.
BILLMITRA_SETUP_TOKEN=
BILLMITRA_BRANCHES='[{"id":"main","name":"Vengara"}]'

# Optional Meta WhatsApp Cloud API delivery-bill sending. Set these only on the
# restaurant server, never in the desktop renderer or phone app. Bills with
# customer consent wait in the local outbox until all four settings are present.
BILLMITRA_WHATSAPP_ACCESS_TOKEN=
BILLMITRA_WHATSAPP_PHONE_NUMBER_ID=
BILLMITRA_WHATSAPP_API_VERSION=
BILLMITRA_WHATSAPP_TEMPLATE_NAME=
BILLMITRA_WHATSAPP_TEMPLATE_LANGUAGE=en
BILLMITRA_WHATSAPP_COUNTRY_CODE=91
