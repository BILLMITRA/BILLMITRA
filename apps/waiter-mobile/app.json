{
  "expo": {
    "name": "BillMitra Staff",
    "slug": "billmitra-waiter",
    "version": "1.1.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.billmitra.waiter"
    },
    "android": {
      "versionCode": 16,
      "package": "com.billmitra.waiter",
      "googleServicesFile": "./google-services.json",
      "permissions": ["android.permission.VIBRATE", "android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow BillMitra Staff to record short voice messages."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "staff-alerts",
          "sounds": ["./assets/waiting_chime.wav"]
        }
      ],
      "expo-asset"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8636388f-f6c8-4809-b678-2a8a87bc9bc1"
      }
    },
    "owner": "billmitras-team"
  }
}
