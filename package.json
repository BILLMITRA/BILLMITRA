{
  "name": "billmitra",
  "description": "Local-first restaurant point-of-sale desktop application",
  "author": "BillMitra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron-dist/electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "node -e \"require('node:fs').rmSync('electron-dist', { recursive: true, force: true })\" && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "start:web": "node electron-dist/electron/web.cjs",
    "restore": "node electron-dist/electron/maintenance.cjs restore",
    "web": "npm run build && npm run start:web",
    "package:win": "npm run build && electron-builder --win nsis --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.harborpos.desktop",
    "productName": "BillMitra",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
